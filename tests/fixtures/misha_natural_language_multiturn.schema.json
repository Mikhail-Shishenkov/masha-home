{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masha-home.local/schemas/misha-natural-language-multiturn-1.0.json",
  "title": "Misha Natural Language Multi-turn Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "turn1",
        "clarification_kind",
        "turn2",
        "expected_outcome",
        "expected_operation_id",
        "expected_known_slots",
        "comment"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
        "turn1": {"type": "string", "minLength": 1, "maxLength": 20000},
        "clarification_kind": {"enum": ["capability", "slot", "referent", "provider_scope"]},
        "turn2": {"type": "string", "minLength": 1, "maxLength": 20000},
        "expected_outcome": {"enum": ["resolved", "still_unresolved", "cancelled", "not_a_follow_up"]},
        "expected_operation_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "expected_known_slots": {
          "type": "object",
          "maxProperties": 24,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"type": "string", "maxLength": 20000}
        },
        "comment": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
