{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masha-home.local/schemas/misha-natural-language-benchmark-1.0.json",
  "title": "Misha Natural Language Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "operationList": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "utterance",
        "expected_candidate_operations",
        "allowed_candidate_alternatives",
        "expected_known_slots",
        "clarification_required",
        "ambiguity_kind",
        "ordinary_conversation",
        "comment"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,79}$"
        },
        "utterance": {"type": "string", "minLength": 1, "maxLength": 20000},
        "expected_candidate_operations": {"$ref": "#/$defs/operationList"},
        "allowed_candidate_alternatives": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/operationList"}
        },
        "expected_known_slots": {
          "type": "object",
          "maxProperties": 24,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"type": "string", "maxLength": 20000}
        },
        "clarification_required": {"type": "boolean"},
        "ambiguity_kind": {
          "enum": ["none", "capability", "slot", "referent", "provider_scope"]
        },
        "ordinary_conversation": {"type": "boolean"},
        "comment": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
